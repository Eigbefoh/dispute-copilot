# Non-secret local configuration template.
# Copy this file to an ignored local environment file before supplying values.

# Live model provider. The application never chooses a provider or model.
# Registered providers: nebius, openai_compatible
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=

# Live integration tests transmit evidence and may incur provider charges.
RUN_MODEL_PROVIDER_INTEGRATION=0

# Trusted local analyst identity resolved when the review server starts.
# This value is never accepted from a browser decision form.
ANALYST_IDENTITY=
